; osx
+BrowserLauncher=(BrowserName="Safari",  BrowserPath=(FilePath="/Applications/Safari.app"))
+BrowserLauncher=(BrowserName="Firefox", BrowserPath=(FilePath="/Applications/Firefox.app"))
+BrowserLauncher=(BrowserName="Chrome",  BrowserPath=(FilePath="/Applications/Google Chrome.app"))

; linux
+BrowserLauncher=(BrowserName="Firefox", BrowserPath=(FilePath="/usr/bin/firefox"))
+BrowserLauncher=(BrowserName="Firefox", BrowserPath=(FilePath="/usr/bin/firefox-trunk"))
+BrowserLauncher=(BrowserName="Chrome", BrowserPath=(FilePath="/usr/bin/google-chrome"))
+BrowserLauncher=(BrowserName="Chrome", BrowserPath=(FilePath="/usr/bin/google-chrome-unstable"))
+BrowserLauncher=(BrowserName="Chromium", BrowserPath=(FilePath="/usr/bin/chromium-browser"))


[/Script/Engine.StreamingSettings]
; wndr IAS (2026-06-14): async loading thread + multithreaded loading enabled going forward (the build is
; SAB-multithreaded; SupportsMultithreading()=true). NOTE: these alone do NOT fix the -Ias first-frame render
; hang (default materials stuck WaitingForIo from a recursive PostLoad flush) — the flush runs on the game
; thread which also owns PostLoad, so the on-demand (async) reads can't complete inline regardless. That fix
; is a synchronously-readable local boot container for boot-critical content. These remain enabled because
; they're wanted for IAS going forward (parallel load steps) and are read from cooked config at AsyncLoading2
; construction (before dpcvars), so they must live here, not as a CVar/dpcvar.
s.AsyncLoadingThreadEnabled=True
s.AllowMultithreadedLoading=True
