-        if (Target.Platform != UnrealTargetPlatform.Mac && Target.Platform != UnrealTargetPlatform.Win64)
+        // UE5-PORT(webgpu): GPULightmass linkage is now an explicit OPT-IN (set UT_GPU_BAKE=1
