+        // SimplyStream/WebGPU cook.
+        bool bWithGPULightmass =
+            Target.Platform != UnrealTargetPlatform.Mac && Target.Platform != UnrealTargetPlatform.Win64 &&
+            System.Environment.GetEnvironmentVariable("UT_GPU_BAKE") == "1";
+        if (bWithGPULightmass)
         {
             PublicDependencyModuleNames.Add("GPULightmass");
         }
+        PublicDefinitions.Add(bWithGPULightmass ? "UT_WITH_GPULIGHTMASS=1" : "UT_WITH_GPULIGHTMASS=0");
 
